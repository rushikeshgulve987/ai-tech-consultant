# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
# Shared secret between the Knowledge Brain and its clients (Tasks 2 and 3)
KB_API_KEY=change-me
KB_USER_AGENT=AICapstoneBot/0.1 (student project; your-email@example.com)

# Models (override to compare models in the evals)
KB_ANSWER_MODEL=claude-sonnet-5-5
KB_VISION_MODEL=claude-haiku-5-5
CLASSIFY_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5
SCOPE_FAST_MODEL=claude-haiku-5-5
SCOPE_STRONG_MODEL=claude-sonnet-5-5

# USD per million tokens [input, output], copied from Anthropic's pricing page. Leave {} and cost columns stay empty.
MODEL_PRICES_JSON={}

# Pricing assumptions for Task 3 proposals (configurable, not a quote)
HOURLY_RATE=50
CURRENCY=USD
TAX_RATE=0

# Set LLM_MODE=mock to run the Inbox Agent UI offline with a canned model (demo only, never for evals)
# LLM_MODE=mock
